{
  "name": "elaris-theme",
  "displayName": "Elaris Theme",
  "description": "A considered dark theme for focused development.",
  "version": "1.0.0",
  "publisher": "nodxide",
  "author": {
    "name": "Nodxide",
    "url": "https://github.com/nodxide"
  },
  "license": "MIT",
  "icon": "assets/logo/elaris-logo-120.png",
  "galleryBanner": {
    "color": "#17171D",
    "theme": "dark"
  },
  "keywords": [
    "elaris",
    "dark theme",
    "color theme",
    "vscode theme",
    "muted colors",
    "syntax highlighting",
    "editor theme",
    "coding theme",
    "calm theme"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Elaris",
        "uiTheme": "vs-dark",
        "path": "./themes/elaris.json"
      }
    ]
  },
  "scripts": {
    "package:vsix": "tsx scripts/package.ts",
    "install:local": "tsx scripts/install-local.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nodxide/vscode-theme-elaris.git"
  },
  "homepage": "https://github.com/nodxide/vscode-theme-elaris#readme",
  "bugs": {
    "url": "https://github.com/nodxide/vscode-theme-elaris/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vscode/vsce": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
