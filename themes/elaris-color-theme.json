  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#91A093",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation", "string.quoted.docstring"],
      "settings": {
        "foreground": "#B7C3B570",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#D58F98"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#D39B7D"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#A8C58D"
      }
    },
    {
      "name": "String quote punctuation",
      "scope": ["punctuation.definition.string"],
      "settings": {
        "foreground": "#A8C58D70"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "meta.template.expression",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#8EBEAE"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "string constant.character.escape"
      ],
      "settings": {
        "foreground": "#8EBEAE"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "source.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#9EB9D4"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "number"],
      "settings": {
        "foreground": "#B8A3D4"
      }
    },
    {
      "name": "Booleans and null values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language",
        "constant.builtin"
      ],
      "settings": {
        "foreground": "#D5B879"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant", "entity.name.constant", "variable.other.constant"],
      "settings": {
        "foreground": "#8EBEAE"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#A8C58D"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#B7C3B5"
      }
    },
    {
      "name": "Class and type names",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#D5B879"
      }
    },
    {
      "name": "Type declarations and annotations",
      "scope": [
        "entity.name.type.annotation",
        "meta.type.annotation",
        "support.type.primitive",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#D5B879"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.property-name",
        "entity.name.tag.yaml",
        "string.unquoted.key"
      ],
      "settings": {
        "foreground": "#7EADA5"
      }
    },
    {
      "name": "Variables and identifiers",
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "#D7DED3"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "meta.module-reference"
      ],
      "settings": {
        "foreground": "#9EB9D4"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#B8A3D4"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#D39B7D"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#D5B879"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#7EADA5"
      }
    },
    {
      "name": "Punctuation and delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "delimiter"
      ],
      "settings": {
        "foreground": "#91A093"
      }
    },
    {
      "name": "Invalid and deprecated code",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#E3A0A7",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "foreground": "#A8C58D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#D7DED3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#D5B879",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#8EBEAE",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown inline and fenced code",
      "scope": ["markup.inline.raw", "markup.raw.inline", "markup.fenced_code"],
      "settings": {
        "foreground": "#8EBEAE"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote", "markup.quote punctuation"],
      "settings": {
        "foreground": "#B7C3B5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list markers",
      "scope": ["markup.list", "punctuation.definition.list"],
      "settings": {
        "foreground": "#A8C58D"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#A8C58D"
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#D58F98"
      }
    },
    {
      "name": "Diff changes",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#D39B7D"
      }
    }
  ],
  "semanticTokenColors": {
